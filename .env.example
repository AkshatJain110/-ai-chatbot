# Gemini API Key Pool (comma-separated, >= 2 keys for key failover)
LLM_API_KEYS=your_first_gemini_api_key,your_second_gemini_api_key

# SQLite Database URL
DATABASE_URL=sqlite:///./app.db

# LLM Model (Gemini Flash)
LLM_MODEL=gemini/gemini-2.0-flash

# Default System Prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.

# Enable Failure Simulation header (X-Simulate-Failure)
ENABLE_FAILURE_SIMULATION=true

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
